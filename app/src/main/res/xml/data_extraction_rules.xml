<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Whitelist: Only DataStore user preferences are backed up to cloud. Financial databases are excluded. -->
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <!-- Include calculation-history database and all SQLite auxiliary files for device-to-device migration -->
        <include domain="database" path="." />
        <!-- Include DataStore user preferences for device-to-device migration -->
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
